<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollViewPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fitsSystemWindows="true">

<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/escudo_antifraude"
                android:textColor="#102A43"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSilenciarVoz"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="🔊"
                android:textSize="18sp"
                app:strokeColor="#CBD5E1" />

            <Button
                android:id="@+id/btnConfigurarFamiliar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/familiar"
                android:textSize="15sp"
                app:strokeColor="#102A43" />
        </LinearLayout>

    <!-- Barra única de 3 acciones rápidas (Foto, Pegar, Llamada) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnElegirCaptura"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#0052CC"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="4dp"
            android:text="📷\nFOTO"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnPegarYComprobar"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#0F766E"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="4dp"
            android:text="📋\nPEGAR"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnVerificarLlamada"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:backgroundTint="#B45309"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="4dp"
            android:text="📞\nLLAMADA"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="O pega aquí el mensaje sospechoso:"
            android:textColor="#334E68"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTextoSospechoso"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:autoLink="none"
            android:background="@android:drawable/edit_text"
            android:gravity="top|start"
            android:hint="@string/pulsa_aqu_y_pega_el_texto_del_sms_o_whatsapp"
            android:inputType="textMultiLine"
            android:linksClickable="false"
            android:padding="12dp"
            android:textColor="#102A43"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAnalizarTexto"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.4"
                android:backgroundTint="#102A43"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:text="2. COMPROBAR"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnBorrarTexto"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:text="🗑️ BORRAR"
                android:textColor="#C62828"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="#C62828" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutCargando"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="56dp"
                android:layout_height="56dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/analizando_si_es_seguro_nespera_un_segundo"
                android:textAlignment="center"
                android:textColor="#102A43"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:id="@+id/layoutColorSemaforo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#D32F2F"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTituloSemaforo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PELIGRO: ES UNA ESTAFA"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCerrarResultado"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="✕"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExplicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:autoLink="none"
                    android:linksClickable="false"
                    android:text="Explicación sencilla aquí..."
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvConsejo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#33000000"
                    android:padding="10dp"
                    android:text="Consejo de acción aquí..."
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRepetirVoz"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#FFFFFF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="🔊 ESCUCHAR OTRA VEZ"
                    android:textColor="#102A43"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnAvisarFamiliar"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#25D366"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="AVISAR A MI FAMILIAR"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnLlamar017"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#102A43"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="📞 LLAMAR GRATIS AL 017 (AYUDA)"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
